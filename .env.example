# Ptium has one mandatory runtime setting: a PostgreSQL DSN.
DATABASE_URL=postgres://ptium:ptium@localhost:5432/ptium?sslmode=disable

# Optional process-level bootstrap settings. All day-to-day service settings are
# subsequently managed from the Ptium administrator console and stored in Postgres.
HTTP_ADDR=:8080
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Use only for the initial administrator claim. In OIDC mode the matching `email`
# claim receives the admin role on first successful sign-in.
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
BOOTSTRAP_ADMIN_SUBJECTS=

# Optional Keycloak / generic OIDC bootstrap. Ptium loads discovery and JWKS from
# OIDC_ISSUER_URL automatically. A public SPA client with PKCE needs no secret.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=ptium-web
OIDC_AUDIENCE=ptium-web
OIDC_ALLOW_HTTP=false
AUTH_ADMIN_ROLES=ptium-admin,admin

# Development-only identity. Never enable in an internet-facing deployment.
DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=replace-with-a-long-random-development-secret
DEV_AUTH_EMAIL=developer@example.com
DEV_AUTH_NAME=Ptium Developer
DEV_AUTH_ROLES=ptium-admin,user
DEV_AUTH_ALLOW_REMOTE=false

# Optional stronger key material for encrypting sensitive administrator settings.
# When omitted, Ptium derives installation-specific material from DATABASE_URL so
# DSN-only startup remains possible. Set this explicitly in production.
KEY_ENCRYPTION_SECRET=

# Optional browser build-time override. Empty means same-origin /api/v1.
VITE_API_BASE_URL=/api/v1

# Values used only by the bundled docker-compose PostgreSQL container.
POSTGRES_DB=ptium
POSTGRES_USER=ptium
POSTGRES_PASSWORD=ptium
