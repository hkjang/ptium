# PTIUM_VERSION is stamped with the release being built when this sample is
# copied into the bundle; the value below is only a placeholder.
PTIUM_VERSION=0.11.0
PTIUM_PORT=8080

# Ptium's only infrastructure dependency. Point this at the PostgreSQL cluster
# the deployment already runs; the release bundle does not ship a database.
DATABASE_URL=postgres://ptium:replace-with-a-long-random-password@postgres.internal:5432/ptium?sslmode=require

PUBLIC_BASE_URL=http://ptium.internal:8080
LOG_LEVEL=info
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
BOOTSTRAP_ADMIN_SUBJECTS=

# A local administrator for the first sign-in, before OIDC is wired up. Seeds the
# account once; set BOOTSTRAP_ADMIN_PASSWORD_RESET=true for one start to
# overwrite a forgotten password.
BOOTSTRAP_ADMIN=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
BOOTSTRAP_ADMIN_NAME=Ptium Administrator
BOOTSTRAP_ADMIN_PASSWORD_RESET=false
SESSION_LIFETIME=12h

# Leave blank to verify startup before identity integration. Configure this and
# OIDC_CLIENT_ID before real users access Ptium, or use dev auth only on an
# isolated evaluation host.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=ptium-web
# Set only for a confidential client; Ptium then exchanges codes server-side.
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=ptium-web
OIDC_ALLOW_HTTP=false
AUTH_ADMIN_ROLES=ptium-admin,admin

DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
DEV_AUTH_EMAIL=
DEV_AUTH_NAME=
DEV_AUTH_ROLES=user
DEV_AUTH_ALLOW_REMOTE=false

KEY_ENCRYPTION_SECRET=replace-with-an-independent-32-byte-random-secret

# Where uploaded images are kept. "database" stores them in PostgreSQL, so the
# deployment has one thing to back up. "filesystem" writes one file per image to
# the ptium-assets volume, which keeps the database small — back that volume up
# with it.
ASSET_STORAGE=database
