PTIUM_VERSION=0.1.0
PTIUM_PORT=8080

POSTGRES_DB=ptium
POSTGRES_USER=ptium
POSTGRES_PASSWORD=replace-with-a-long-random-password

PUBLIC_BASE_URL=http://ptium.internal:8080
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
BOOTSTRAP_ADMIN_SUBJECTS=

# Leave blank to verify startup before identity integration. Configure this and
# OIDC_CLIENT_ID before real users access Ptium, or use dev auth only on an
# isolated evaluation host.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=ptium-web
OIDC_AUDIENCE=ptium-web
OIDC_ALLOW_HTTP=false
AUTH_ADMIN_ROLES=ptium-admin,admin

DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
DEV_AUTH_EMAIL=
DEV_AUTH_NAME=
DEV_AUTH_ROLES=user
DEV_AUTH_ALLOW_REMOTE=false

KEY_ENCRYPTION_SECRET=replace-with-an-independent-32-byte-random-secret
